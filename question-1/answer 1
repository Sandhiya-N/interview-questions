def SearchingChallenge(strArr):
    grid = [list(row) for row in strArr]
    rows, cols = len(grid), len(grid[0])
    holes = 0

    for i in range(rows):
        for j in range(cols):
            if grid[i][j] == '0':
                holes += 1
                stack = [(i, j)]

                while stack:
                    r, c = stack.pop()
                    if (r < 0 or r >= rows or c < 0 or
                        c >= cols or grid[r][c] != '0'):
                        continue

                    grid[r][c] = '1'

                    stack.extend([
                        (r-1, c), (r+1, c),
                        (r, c-1), (r, c+1)
                    ])

    return holes
print(SearchingChallenge(input()))